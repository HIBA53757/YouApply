<%- include('../partials/header', { title: 'YouApply - Mes Offres Suivies (Responsive)', active: 'suivies', bodyAttrs: 'data-page="followed"' }) %>

    <main class="max-w-[1400px] mx-auto px-4 md:px-6 lg:px-8 py-6 md:py-8 flex-grow w-full">

        <section class="page-hero mb-6 md:mb-8" aria-labelledby="page-title">
            <div class="page-hero__content">
                <p class="page-hero__eyebrow">Ma sélection</p>
                <h1 id="page-title" class="page-hero__title">Mes offres suivies</h1>
                <p class="page-hero__description">Retrouvez les stages et alternances que vous avez sauvegardés pour
                    préparer vos candidatures.</p>
            </div>
            <span class="page-hero__badge">Opportunités sauvegardées</span>
        </section>

        <section>

            <div class="flex justify-end mb-6 md:mb-8">
                <a href="index.html"
                    class="w-full sm:w-auto flex-shrink-0 flex items-center justify-center gap-2 bg-blue-700 text-white font-medium text-sm px-5 py-2.5 rounded-xl hover:bg-blue-900 transition-colors shadow-sm">
                    <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 4v16m8-8H4"></path>
                    </svg>
                    Explorer d'autres offres
                </a>
            </div>

            <div
                class="flex flex-col md:flex-row md:items-center justify-between gap-4 mb-6 border-b border-slate-200 pb-4">
                <div
                    class="flex items-center gap-2 overflow-x-auto pb-2 md:pb-0 [&::-webkit-scrollbar]:hidden w-full md:w-auto -mx-4 px-4 md:mx-0 md:px-0">
                    <button data-contract="all"
                        class="contract-tab bg-blue-700 text-white px-4 py-1.5 rounded-full text-sm font-medium shadow-sm flex items-center gap-1.5 whitespace-nowrap">
                        Toutes
                    </button>
                    <button data-contract="stage"
                        class="contract-tab bg-slate-100 text-slate-600 hover:bg-slate-200 px-4 py-1.5 rounded-full text-sm font-medium transition-colors flex items-center gap-1.5 whitespace-nowrap">
                        Stages <span class="text-slate-400 text-xs">(1)</span>
                    </button>
                    <button data-contract="alternance"
                        class="contract-tab bg-slate-100 text-slate-600 hover:bg-slate-200 px-4 py-1.5 rounded-full text-sm font-medium transition-colors flex items-center gap-1.5 whitespace-nowrap">
                        Alternances <span class="text-slate-400 text-xs">(2)</span>
                    </button>
                </div>
            </div>

            <div id="Offers_List" class="space-y-4 mb-12"></div>

            <div id="empty-followed-offers" class="hidden mt-8">
                <div
                    class="bg-white border-2 border-dashed border-slate-200 rounded-3xl p-8 md:p-12 flex flex-col items-center justify-center text-center">
                    <div class="w-16 h-16 bg-blue-50 text-blue-700 rounded-2xl flex items-center justify-center mb-6">
                        <svg class="w-8 h-8" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5"
                                d="M5 5a2 2 0 012-2h10a2 2 0 012 2v16l-7-3.5L5 21V5z"></path>
                        </svg>
                    </div>
                    <h3 class="text-lg md:text-xl font-bold text-slate-800 mb-2">Aucune
                        offre suivie pour le moment</h3>
                    <p class="text-sm text-slate-500 max-w-md mx-auto">Explorez
                        les offres disponibles et cliquez sur "Suivre"
                        pour les retrouver ici à tout moment.</p>

                </div>
            </div>

        </section>
    </main>

    <script type="module" src="/js/followed-offers.js"></script>

<%- include('../partials/footer') %>
