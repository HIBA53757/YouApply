<%
    // If there is no offer, we use an empty object (create mode)
    const o = offer || {};

    // Create: send to /deposer-offer. Edit: send to /offres/ID/update
    let action = '/deposer-offer';
    let startDate = '';
    if (offer) {
        action = '/offres/' + offer.id + '/update';
        startDate = offer.date_debut.toLocaleDateString('sv-SE');
    }

    // Technologies already chosen (empty list in create mode)
    const selected = (o.skills || '').split(',');

    const allSkills = ['HTML', 'CSS', 'JavaScript', 'PHP', 'MySQL', 'React', 'Figma', 'Git / GitHub', 'Laravel', 'Node.js'];
    const durations = [1, 2, 3, 4, 6, 12, 24];
    const inputClass = 'w-full bg-slate-50 border border-slate-200 text-sm rounded-xl px-4 py-3';
%>
<%- include('../partials/header', { title: 'YouApply - Déposer une offre', active: 'deposer' }) %>

<main class="max-w-[1400px] mx-auto px-4 md:px-6 lg:px-8 py-6 md:py-8 flex-grow w-full">

    <section class="page-hero mb-6 md:mb-8">
        <div class="page-hero__content">
            <p class="page-hero__eyebrow">Espace recruteur</p>
            <h1 class="page-hero__title">Déposer ou modifier une offre</h1>
            <p class="page-hero__description">Remplissez les informations ci-dessous.</p>
        </div>
    </section>

    <form action="<%= action %>" method="post" class="space-y-6">

        <section class="bg-white rounded-3xl p-5 md:p-8 border border-slate-200 shadow-sm space-y-6">
            <h2 class="text-lg font-bold text-slate-800">Informations générales</h2>

            <fieldset>
                <legend class="text-sm font-semibold text-slate-800 mb-3">Type d'opportunité *</legend>
                <label class="mr-6">
                    <input type="radio" name="opp_type" value="stage" required
                        <%= o.type_contrat !== 'alternance' ? 'checked' : '' %>> Stage
                </label>
                <label>
                    <input type="radio" name="opp_type" value="alternance"
                        <%= o.type_contrat === 'alternance' ? 'checked' : '' %>> Alternance
                </label>
            </fieldset>

            <div class="grid grid-cols-1 md:grid-cols-2 gap-5">
                <div>
                    <label for="company" class="block text-sm font-semibold mb-2">Nom de l'entreprise *</label>
                    <input id="company" name="company" type="text" required class="<%= inputClass %>"
                        value="<%= o.entreprise_nom %>">
                </div>

                <div>
                    <label for="location" class="block text-sm font-semibold mb-2">Ville *</label>
                    <input id="location" name="location" type="text" required class="<%= inputClass %>"
                        value="<%= o.ville %>">
                </div>

                <div>
                    <label for="job_title" class="block text-sm font-semibold mb-2">Intitulé du poste *</label>
                    <input id="job_title" name="job_title" type="text" required class="<%= inputClass %>"
                        value="<%= o.titre %>">
                </div>

                <div>
                    <label for="work_mode" class="block text-sm font-semibold mb-2">Mode de travail *</label>
                    <select id="work_mode" name="work_mode" required class="<%= inputClass %>">
                        <option value="">Sélectionner un mode</option>
                        <option value="presentiel" <%= o.mode_travail === 'presentiel' ? 'selected' : '' %>>Présentiel</option>
                        <option value="hybride" <%= o.mode_travail === 'hybride' ? 'selected' : '' %>>Hybride</option>
                        <option value="remote" <%= o.mode_travail === 'remote' ? 'selected' : '' %>>Télétravail</option>
                    </select>
                </div>

                <div>
                    <label for="work_method" class="block text-sm font-semibold mb-2">Méthode de travail</label>
                    <input id="work_method" name="work_method" type="text" placeholder="ex. Agile / Scrum"
                        class="<%= inputClass %>" value="<%= o.methode_travail %>">
                </div>

                <div>
                    <label for="remote_policy" class="block text-sm font-semibold mb-2">Politique de télétravail</label>
                    <input id="remote_policy" name="remote_policy" type="text" placeholder="ex. 2 jours / semaine"
                        class="<%= inputClass %>" value="<%= o.politique_teletravail %>">
                </div>

                <div>
                    <label for="work_address" class="block text-sm font-semibold mb-2">Adresse du lieu de travail</label>
                    <input id="work_address" name="work_address" type="text"
                        class="<%= inputClass %>" value="<%= o.adresse_travail %>">
                </div>
            </div>
        </section>

        <section class="bg-white rounded-3xl p-5 md:p-8 border border-slate-200 shadow-sm space-y-6">
            <h2 class="text-lg font-bold text-slate-800">Contenu & missions</h2>

            <div>
                <label for="description" class="block text-sm font-semibold mb-2">Présentation de l'entreprise *</label>
                <textarea id="description" name="description" rows="3" required
                    class="<%= inputClass %>"><%= o.presentation_entreprise %></textarea>
            </div>

            <div>
                <label for="missions" class="block text-sm font-semibold mb-2">Missions principales *</label>
                <textarea id="missions" name="missions" rows="4" required
                    class="<%= inputClass %>"><%= o.missions %></textarea>
            </div>

            <fieldset>
                <legend class="text-sm font-semibold mb-3">Technologies</legend>
                <div class="flex flex-wrap gap-4">
                    <% allSkills.forEach(skill => { %>
                        <label class="flex items-center gap-2 text-sm">
                            <input type="checkbox" name="skills" value="<%= skill %>"
                                <%= selected.includes(skill) ? 'checked' : '' %>>
                            <%= skill %>
                        </label>
                    <% }) %>
                </div>
            </fieldset>
        </section>

        <section class="bg-white rounded-3xl p-5 md:p-8 border border-slate-200 shadow-sm space-y-6">
            <h2 class="text-lg font-bold text-slate-800">Modalités & contact</h2>

            <div class="grid grid-cols-1 md:grid-cols-2 gap-5">
                <div>
                    <label for="start_date" class="block text-sm font-semibold mb-2">Date de début *</label>
                    <input id="start_date" name="start_date" type="date" required
                        class="<%= inputClass %>" value="<%= startDate %>">
                </div>

                <div>
                    <label for="duration" class="block text-sm font-semibold mb-2">Durée du contrat *</label>
                    <select id="duration" name="duration" required class="<%= inputClass %>">
                        <option value="">Sélectionner une durée</option>
                        <% durations.forEach(months => { %>
                            <option value="<%= months %>" <%= o.duree_mois === months ? 'selected' : '' %>>
                                <%= months %> mois
                            </option>
                        <% }) %>
                    </select>
                </div>
            </div>

            <div>
                <label for="email" class="block text-sm font-semibold mb-2">Email de réception des candidatures *</label>
                <input id="email" name="email" type="email" required class="<%= inputClass %>"
                    value="<%= o.email_contact %>">
            </div>
        </section>

        <div class="rounded-3xl border border-slate-200 bg-white p-4 md:p-6 shadow-sm">
            <p class="mb-4 text-xs text-slate-500">Les champs marqués d'un * sont obligatoires.</p>
            <button type="submit"
                class="bg-blue-700 text-white font-semibold text-sm px-6 py-3 rounded-xl hover:bg-blue-900">
                Enregistrer
            </button>
        </div>
    </form>
</main>

<%- include('../partials/footer') %>