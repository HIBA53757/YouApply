<%- include('../partials/header', { title: 'YouApply - Offres', active: 'index' }) %>

<main class="max-w-[1400px] mx-auto px-4 md:px-6 lg:px-8 py-6 md:py-8 flex-grow w-full">

    <section class="page-hero mb-6 md:mb-8">
        <div class="page-hero__content">
            <p class="page-hero__eyebrow">Espace étudiant</p>
            <h1 class="page-hero__title">Trouvez votre prochaine opportunité</h1>
            <p class="page-hero__description">Explorez les offres de stage et d'alternance, puis trouvez celles qui correspondent à votre projet.</p>
        </div>
        <span class="page-hero__badge">Stages & alternances</span>
    </section>

    <!-- One form for search, filters and sort. It sends a GET request to "/" -->
    <form action="/" method="get">

        <!-- Search -->
        <section class="bg-white rounded-2xl shadow-sm border border-slate-200 p-3 mb-6 flex flex-col md:flex-row gap-3">
            <input name="keyword" type="text" value="<%= filters.keyword || '' %>"
                placeholder="Mots-clés : Développeur, UX..."
                class="flex-1 bg-slate-100 rounded-xl px-4 py-3.5 text-sm">

            <input name="city" type="text" value="<%= filters.city || '' %>"
                placeholder="Ville..."
                class="flex-1 bg-slate-100 rounded-xl px-4 py-3.5 text-sm">

            <button type="submit"
                class="bg-blue-700 hover:bg-blue-900 text-white font-medium text-sm px-8 py-3.5 rounded-xl">
                Rechercher
            </button>
        </section>

        <div class="grid grid-cols-1 lg:grid-cols-12 gap-6">

            <!-- Filters -->
            <aside class="lg:col-span-3">
                <div class="bg-white rounded-2xl shadow-sm border border-slate-200 p-5">

                    <div class="flex items-center justify-between mb-6">
                        <h2 class="text-base font-semibold text-slate-800">Filtres</h2>
                        <a href="/" class="text-sm font-medium text-blue-700 hover:underline">Effacer tout</a>
                    </div>

                    <fieldset class="mb-6">
                        <legend class="text-sm font-semibold mb-3">Type de contrat</legend>
                        <select name="contract" onchange="this.form.submit()"
                            class="w-full bg-slate-100 rounded-xl py-2 px-3 text-sm">
                            <option value="">Tous</option>
                            <option value="stage" <%= filters.contract === 'stage' ? 'selected' : '' %>>Stage</option>
                            <option value="alternance" <%= filters.contract === 'alternance' ? 'selected' : '' %>>Alternance</option>
                        </select>
                    </fieldset>

                    <fieldset class="mb-6">
                        <legend class="text-sm font-semibold mb-3">Mode de travail</legend>
                        <select name="workMode" onchange="this.form.submit()"
                            class="w-full bg-slate-100 rounded-xl py-2 px-3 text-sm">
                            <option value="">Tous</option>
                            <option value="presentiel" <%= filters.workMode === 'presentiel' ? 'selected' : '' %>>Présentiel</option>
                            <option value="hybride" <%= filters.workMode === 'hybride' ? 'selected' : '' %>>Hybride</option>
                            <option value="remote" <%= filters.workMode === 'remote' ? 'selected' : '' %>>Télétravail 100%</option>
                        </select>
                    </fieldset>

                    <fieldset>
                        <legend class="text-sm font-semibold mb-3">Technologie</legend>
                        <select name="technology" onchange="this.form.submit()"
                            class="w-full bg-slate-100 rounded-xl py-2 px-3 text-sm">
                            <option value="">Toutes</option>
                            <% technologies.forEach(technology => { %>
                                <option value="<%= technology %>" <%= filters.technology === technology ? 'selected' : '' %>>
                                    <%= technology %>
                                </option>
                            <% }) %>
                        </select>
                    </fieldset>

                </div>
            </aside>

            <!-- Offers -->
            <section class="lg:col-span-9">

                <header class="bg-white p-4 rounded-2xl border border-slate-200 shadow-sm flex flex-col sm:flex-row sm:items-center justify-between mb-6 gap-4">
                    <h2 class="text-slate-600">
                        <strong class="text-2xl text-slate-800"><%= offers.length %></strong>
                        <span class="text-sm font-medium">offres trouvées</span>
                    </h2>

                    <div class="flex items-center gap-2">
                        <label class="text-sm font-bold text-slate-700">Trier par :</label>
                        <select name="sort" onchange="this.form.submit()"
                            class="bg-slate-100 text-sm font-semibold rounded-xl py-2 px-3">
                            <option value="recent">Les plus récentes</option>
                            <option value="oldest" <%= filters.sort === 'oldest' ? 'selected' : '' %>>Les plus anciennes</option>
                        </select>
                    </div>
                </header>

                <div class="space-y-4 mb-8">
                    <% offers.forEach(offer => { %>

                        <article class="bg-white p-5 md:p-6 rounded-2xl shadow-sm border border-slate-200">
                            <div class="flex items-start gap-4">

                                <div class="w-14 h-14 rounded-xl bg-blue-700 text-white flex items-center justify-center font-bold text-xl flex-shrink-0">
                                    <%= offer.entreprise_nom.charAt(0).toUpperCase() %>
                                </div>

                                <div class="flex-1 min-w-0">
                                    <div class="flex items-start justify-between gap-4">
                                        <div>
                                            <h2 class="text-lg md:text-xl font-bold text-slate-800 mb-2"><%= offer.titre %></h2>
                                            <span class="bg-blue-100 text-blue-900 text-xs font-bold px-3 py-1 rounded-full"><%= offer.type_contrat %></span>
                                            <p class="mt-2 text-sm text-slate-700">
                                                <%= offer.entreprise_nom %> - <%= offer.ville %>
                                                - Début le <%= offer.date_debut.toLocaleDateString('fr-FR') %>
                                            </p>
                                        </div>

                                        <!-- Follow button (used by followBtn.js) -->
                                        <button type="button" data-offer-id="<%= offer.id %>"
                                            class="text-slate-300 hover:text-slate-500 p-1 flex-shrink-0">
                                            <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2"
                                                    d="M5 5a2 2 0 012-2h10a2 2 0 012 2v16l-7-3.5L5 21V5z"></path>
                                            </svg>
                                        </button>
                                    </div>

                                    <p class="mt-4 text-sm text-slate-600 line-clamp-2"><%= offer.presentation_entreprise %></p>

                                    <div class="mt-5 flex flex-col md:flex-row md:items-center justify-between gap-4 pt-5 border-t border-slate-100">

                                        <div class="flex flex-wrap gap-2">
                                            <% if (offer.skills) { %>
                                                <% offer.skills.split(',').forEach(skill => { %>
                                                    <span class="bg-slate-100 text-slate-600 text-xs font-semibold px-3 py-1.5 rounded-lg"><%= skill %></span>
                                                <% }) %>
                                            <% } %>
                                        </div>

                                        <a href="/offer-details.html?id=<%= offer.id %>"
                                            class="bg-blue-700 hover:bg-blue-900 text-white text-sm font-medium px-5 py-2.5 rounded-xl text-center">
                                            Voir l'offre
                                        </a>
                                    </div>
                                </div>
                            </div>
                        </article>

                    <% }) %>
                </div>

                <% if (offers.length === 0) { %>
                    <div class="text-center py-10">
                        <p class="text-lg font-semibold text-slate-700">Aucune offre trouvée</p>
                        <p class="text-sm text-slate-500 mt-2">Essayez de modifier vos critères de recherche.</p>
                    </div>
                <% } %>

            </section>
        </div>
    </form>
</main>

<script type="module" src="/js/followBtn.js"></script>

<%- include('../partials/footer') %>