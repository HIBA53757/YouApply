<%- include('../partials/header', { title: 'YouApply - Administration', active: 'administration' }) %>

<main class="max-w-[1400px] mx-auto px-4 md:px-6 lg:px-8 py-6 md:py-8 flex-grow w-full">

    <section class="page-hero mb-6 md:mb-8">
        <div class="page-hero__content">
            <p class="page-hero__eyebrow">Back-office</p>
            <h1 class="page-hero__title">Administration des offres</h1>
            <p class="page-hero__description">Gérez les opportunités proposées aux étudiants.</p>
        </div>
        <span class="page-hero__badge">Gestion des offres</span>
    </section>

    <div class="flex justify-end mb-6">
        <a href="/deposer-offer.html"
            class="px-4 py-2.5 text-sm font-medium text-white bg-blue-700 rounded-xl hover:bg-blue-900">
            + Ajouter une offre
        </a>
    </div>

    <div class="bg-white border border-slate-200 rounded-2xl shadow-sm overflow-x-auto">
        <table class="w-full text-left text-sm">
            <thead class="bg-slate-50 text-xs font-semibold text-slate-500 uppercase">
                <tr>
                    <th class="px-6 py-4">Poste</th>
                    <th class="px-6 py-4">Entreprise & Ville</th>
                    <th class="px-6 py-4">Type</th>
                    <th class="px-6 py-4">Date de publication</th>
                    <th class="px-6 py-4 text-right">Actions</th>
                </tr>
            </thead>
            <tbody class="divide-y divide-slate-100">

                <% offers.forEach(offer => { %>
                    <tr>
                        <td class="px-6 py-4 font-bold text-slate-800"><%= offer.titre %></td>
                        <td class="px-6 py-4">
                            <div class="font-bold text-slate-700"><%= offer.entreprise_nom %></div>
                            <div class="text-xs text-slate-500"><%= offer.ville %></div>
                        </td>
                        <td class="px-6 py-4"><%= offer.type_contrat %></td>
                        <td class="px-6 py-4"><%= offer.date_publication.toLocaleDateString('fr-FR') %></td>
                        <td class="px-6 py-4">
                            <div class="flex items-center justify-end gap-2">

                                <a href="/offer-edit.html?id=<%= offer.id %>"
                                    class="px-3 py-1.5 text-blue-700 bg-blue-50 rounded-lg hover:bg-blue-100">
                                    Éditer
                                </a>

                                <form action="/offres/<%= offer.id %>/delete" method="post"
                                    onsubmit="return confirm('Supprimer cette offre ?')">
                                    <button type="submit"
                                        class="px-3 py-1.5 text-red-600 bg-red-50 rounded-lg hover:bg-red-100">
                                        Supprimer
                                    </button>
                                </form>

                            </div>
                        </td>
                    </tr>
                <% }) %>

                <% if (offers.length === 0) { %>
                    <tr>
                        <td colspan="5" class="px-6 py-10 text-center text-slate-500">Aucune offre.</td>
                    </tr>
                <% } %>

            </tbody>
        </table>
    </div>

</main>

<%- include('../partials/footer') %>