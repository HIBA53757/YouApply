<%- include('../partials/header', { title: 'YouApply - Administration', active: 'administration' }) %>

    <main class="max-w-[1400px] mx-auto px-4 md:px-6 lg:px-8 py-6 md:py-8 flex-grow w-full">

        <section class="page-hero mb-6 md:mb-8" aria-labelledby="page-title">
            <div class="page-hero__content">
                <p class="page-hero__eyebrow">Back-office</p>
                <h1 id="page-title" class="page-hero__title">Administration des offres</h1>
                <p class="page-hero__description">Suivez les annonces et gérez les opportunités proposées aux étudiants.
                </p>
            </div>
            <span class="page-hero__badge">Gestion des offres</span>
        </section>

        <div class="flex justify-end mb-6 md:mb-8">
            <div class="flex flex-col sm:flex-row items-center gap-3 w-full sm:w-auto">

                <a href="deposer-offer.html"
                    class="w-full sm:w-auto flex items-center justify-center gap-2 px-4 py-2.5 text-sm font-medium text-white bg-blue-700 rounded-xl hover:bg-blue-900 transition-colors shadow-sm">
                    <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 4v16m8-8H4"></path>
                    </svg>
                    Ajouter une offre manuellement
                </a>
            </div>
        </div>

        <section class="mb-8">
            <% if (message) { %>
            <p class="mb-4 rounded-xl bg-emerald-50 border border-emerald-200 px-4 py-3 text-sm text-emerald-800" role="status"><%= message %></p>
            <% } %>

            <div class="bg-transparent lg:bg-white lg:border lg:border-slate-200 lg:border-t-0 lg:shadow-sm">

                <table class="w-full text-left border-collapse">

                    <thead
                        class="hidden lg:table-header-group bg-slate-50/80 text-xs font-semibold text-slate-500 uppercase tracking-wider border-b border-slate-200">
                        <tr>
                            <th scope="col" class="px-6 py-4">Intitulé du
                                poste & Référence</th>
                            <th scope="col" class="px-6 py-4">Entreprise &
                                Ville</th>
                            <th scope="col" class="px-6 py-4">Type</th>
                            <th scope="col" class="px-6 py-4">Date de
                                soumission</th>
                            <th scope="col" class="px-6 py-4">Statut</th>
                            <th scope="col" class="px-6 py-4 text-right">Actions</th>
                        </tr>
                    </thead>

                    <tbody
                        class="flex flex-col gap-4 lg:table-row-group lg:gap-0 lg:divide-y lg:divide-slate-100 text-sm">

                        <% if (offers.length === 0) { %>
                        <tr><td colspan="6" class="px-6 py-8 text-center text-slate-500">Aucune offre enregistrée.</td></tr>
                        <% } else { offers.forEach(offer => { %>

                        <tr
                            class="flex flex-col lg:table-row bg-white border border-slate-200 lg:border-none rounded-2xl lg:rounded-none p-4 lg:p-0 shadow-sm lg:shadow-none hover:bg-slate-50 transition-colors group">

                            <td class="block lg:table-cell lg:px-6 lg:py-4 mb-3 lg:mb-0">
                                <div class="flex items-start justify-between">
                                    <div>
                                        <div class="font-bold text-slate-800 text-base md:text-sm pr-4"><%= offer.titre %></div>
                                        <div class="text-[11px] text-slate-400 font-bold uppercase mt-1 tracking-wider">
                                            REF : OFF-<%= offer.id %></div>
                                    </div>
                                    <div class="lg:hidden flex-shrink-0">
                                        <span
                                            class="inline-flex items-center gap-1 bg-emerald-50 text-emerald-700 px-2 py-1 rounded-lg text-[10px] font-bold border border-emerald-100">
                                            <span class="w-1.5 h-1.5 rounded-full bg-emerald-500"></span>Publiée
                                        </span>
                                    </div>
                                </div>
                            </td>

                            <td class="block lg:table-cell lg:px-6 lg:py-4 mb-4 lg:mb-0">
                                <div class="flex items-center justify-between lg:block">
                                    <div>
                                        <div class="font-bold text-slate-700"><%= offer.entreprise_nom %></div>
                                        <div class="text-xs text-slate-500 flex items-center gap-1 mt-0.5">
                                            <svg class="w-3.5 h-3.5 text-slate-400" fill="none" stroke="currentColor"
                                                viewBox="0 0 24 24">
                                                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2"
                                                    d="M17.657 16.657L13.414 20.9a1.998 1.998 0 01-2.827 0l-4.244-4.243a8 8 0 1111.314 0z">
                                                </path>
                                                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2"
                                                    d="M15 11a3 3 0 11-6 0 3 3 0 016 0z"></path>
                                            </svg>
                                            <%= offer.ville %>
                                        </div>
                                    </div>
                                    <div class="lg:hidden">
                                        <span
                                            class="bg-teal-100 text-teal-700 text-[10px] font-bold px-2.5 py-1 rounded-lg uppercase tracking-wider"><%= offer.type_contrat %></span>
                                    </div>
                                </div>
                            </td>

                            <td class="hidden lg:table-cell px-6 py-4 whitespace-nowrap">
                                <span
                                    class="bg-teal-100 text-teal-700 text-[10px] font-bold px-2.5 py-1 rounded-full uppercase tracking-wider"><%= offer.type_contrat %></span>
                            </td>
                            <td class="hidden lg:table-cell px-6 py-4 whitespace-nowrap">
                                <div class="font-semibold text-slate-700"><%= new Date(offer.date_publication).toLocaleDateString('fr-FR') %></div>
                            </td>
                            <td class="hidden lg:table-cell px-6 py-4 whitespace-nowrap">
                                <span
                                    class="inline-flex items-center gap-1.5 bg-emerald-50 text-emerald-700 px-2.5 py-1 rounded-full text-xs font-bold border border-emerald-100">
                                    <span class="w-1.5 h-1.5 rounded-full bg-emerald-500"></span>
                                    Publiée
                                </span>
                            </td>

                            <td
                                class="block lg:table-cell lg:px-6 lg:py-4 pt-3 lg:pt-4 border-t border-slate-100 lg:border-0 text-right">
                                <div class="flex items-center justify-between lg:justify-end gap-2">
                                    <div class="text-xs text-slate-400 font-medium lg:hidden">
                                        Soumis le <%= new Date(offer.date_publication).toLocaleDateString('fr-FR') %>
                                    </div>
                                    <div class="flex items-center gap-2">
                                        <a href="/offer-edit.html?id=<%= offer.id %>" class="text-blue-700 hover:underline">Modifier</a>
                                        <form action="/offres/<%= offer.id %>/delete" method="post" onsubmit="return confirm('Supprimer cette offre ?')">
                                            <button type="submit" class="text-red-600 hover:underline">Supprimer</button>
                                        </form>
                                    </div>
                                </div>
                            </td>
                        </tr>
                        <% }); } %>

                    </tbody>
                </table>
            </div>
        </section>

    </main>

<%- include('../partials/footer') %>
