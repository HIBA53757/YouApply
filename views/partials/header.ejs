<%
    const page = typeof active !== 'undefined' ? active : '';
    const desktopClass = (name) => page === name
        ? 'bg-blue-50 text-blue-700 px-4 py-2 rounded-lg'
        : 'hover:text-slate-900';
    const mobileClass = (name) => page === name
        ? 'bg-blue-50 text-blue-700 px-4 py-3 rounded-lg font-medium'
        : 'text-slate-600 hover:bg-slate-50 px-4 py-3 rounded-lg font-medium';
%>
<!DOCTYPE html>
<html lang="fr">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>YouApply</title>
    <script src="https://cdn.tailwindcss.com"></script>
    <link rel="stylesheet" href="/css/style.css">
</head>

<body class="bg-slate-50 text-slate-800 antialiased flex flex-col min-h-screen">

    <header class="bg-white border-b border-slate-200 sticky top-0 z-50">
        <div class="max-w-[1400px] mx-auto px-4 md:px-6 lg:px-8 h-16 flex items-center justify-between">

            <div class="flex items-center gap-2">
                <a href="index.html" class="font-bold text-xl flex items-center">
                    <span class="text-black">You</span><span class="brand-apply">Apply</span>
                </a>
                <span
                    class="hidden sm:block text-xs text-slate-500 font-medium leading-tight ml-2 border-l border-slate-300 pl-2">STAGES
                    &<br>ALTERNANCES</span>
            </div>

            <nav class="hidden lg:flex items-center gap-6 text-sm font-medium text-slate-600">
                <a href="index.html" class="<%= desktopClass('index') %>">Trouver une offre</a>
                <a href="offer-suivies.html" class="<%= desktopClass('suivies') %> flex items-center gap-2">Offres suivies</a>
                <a href="deposer-offer.html" class="<%= desktopClass('deposer') %>">Déposer une offre</a>
                <a href="administration.html" class="<%= desktopClass('administration') %>">Administration</a>
            </nav>

            <div class="hidden lg:flex items-center">
                <div class="flex items-center gap-3">
                    <div class="text-right">
                        <div class="text-sm font-semibold text-slate-800">Espace Étudiant</div>
                        <a href="#" class="text-xs text-blue-700 hover:underline">Changer de rôle</a>
                    </div>
                    <div class="w-9 h-9 rounded-full bg-blue-700 text-white flex items-center justify-center shadow-sm">
                        <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2"
                                d="M16 7a4 4 0 11-8 0 4 4 0 018 0zM12 14a7 7 0 00-7 7h14a7 7 0 00-7-7z"></path>
                        </svg>
                    </div>
                </div>
            </div>

            <div class="flex lg:hidden items-center gap-3">
                <button
                    class="w-10 h-10 rounded-full bg-blue-700 text-white flex items-center justify-center shadow-sm">
                    <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2"
                            d="M16 7a4 4 0 11-8 0 4 4 0 018 0zM12 14a7 7 0 00-7 7h14a7 7 0 00-7-7z"></path>
                    </svg>
                </button>
                <button id="mobile-menu-btn"
                    class="w-10 h-10 bg-slate-100 rounded-xl flex items-center justify-center text-slate-700 hover:bg-slate-200 transition-colors">
                    <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2"
                            d="M4 6h16M4 12h16M4 18h16"></path>
                    </svg>
                </button>
            </div>
        </div>

        <div id="mobile-menu" class="hidden lg:hidden border-t border-slate-200 bg-white absolute w-full shadow-lg">
            <nav class="flex flex-col p-4 space-y-2">
                <a href="index.html" class="<%= mobileClass('index') %>">Trouver une offre</a>
                <a href="offer-suivies.html" class="<%= mobileClass('suivies') %> flex items-center justify-between">Offres suivies</a>
                <a href="deposer-offer.html" class="<%= mobileClass('deposer') %>">Déposer une offre</a>
                <a href="administration.html" class="<%= mobileClass('administration') %>">Administration</a>
                <div class="h-px bg-slate-200 my-2"></div>
                <div class="px-4 py-2">
                    <div class="text-sm text-slate-500 mb-1">Connecté en tant que</div>
                    <div class="font-semibold text-slate-800">Espace Étudiant</div>
                    <a href="#" class="text-sm text-blue-700 hover:underline mt-1 inline-block">Changer de rôle</a>
                </div>
            </nav>
        </div>
    </header>
